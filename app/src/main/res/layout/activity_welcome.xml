<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1B1A1A"
    android:padding="28dp"
    android:textDirection="rtl"
    android:layoutDirection="rtl">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_ride"
        app:tint="#FFD600" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحباً بك في SonicTaxi"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFD600"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الرجاء اختيار نوع الحساب للمتابعة"
        android:textSize="14sp"
        android:textColor="#B0B0B0"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_driver_entry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="دخول كـ سائق"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1B1A1A"
        android:backgroundTint="#FFD600"
        android:layout_marginBottom="16dp"
        app:cornerRadius="30dp"
        android:elevation="4dp"/>

    <Button
        android:id="@+id/btn_manager_entry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="دخول كـ مدير مكتب"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFD600"
        android:backgroundTint="#252424"
        android:layout_marginBottom="16dp"
        app:strokeColor="#FFD600"
        app:strokeWidth="2dp"
        app:cornerRadius="30dp"
        android:elevation="4dp"/>

    <Button
        android:id="@+id/btn_customer_entry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="دخول كـ زبون"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1B1A1A"
        android:backgroundTint="#FFD600"
        app:cornerRadius="30dp"
        android:elevation="4dp"/>

</LinearLayout>